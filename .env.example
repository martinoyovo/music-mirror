NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
OPENAI_API_KEY=your_openai_api_key

# Optional. If omitted, the app uses /callback on the current origin.
# Local default: http://127.0.0.1:3000/callback
# Production default: https://your-domain.com/callback
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=

# Optional. Defaults to gpt-5.2.
OPENAI_MODEL=
